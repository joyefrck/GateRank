# Managed by GateRank log maintenance
[Unit]
Description=GateRank hourly log maintenance
Documentation=file://@@CONFIG_DIR@@/README
After=docker.service

[Service]
Type=oneshot
ExecStart=@@INSTALL_SCRIPT@@ run
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=@@LOG_DIR@@ @@STATE_DIR@@ @@LOCK_DIR@@

[Install]
WantedBy=multi-user.target
