# Install the real file as /etc/gaterank-probe.env with mode 0600.
PROBE_API_BASE=https://gate-rank.com/api/v1/performance-probe
PROBE_API_TOKEN=
PROBE_WORKER_ID=replace-with-probe-hostname
PROBE_HTTP_TIMEOUT=10
PROBE_PROXY_PORT=7890
PROBE_PROXY_STARTUP_TIMEOUT=8
PROBE_LATENCY_ATTEMPTS=3
PROBE_REQUEST_LOSS_ATTEMPTS=10
PROBE_SPEED_TIMEOUT=10
PROBE_SPEED_CONNECTIONS=2
SING_BOX_BIN=/opt/gaterank-probe/bin/sing-box
