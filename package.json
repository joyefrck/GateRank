{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=127.0.0.1",
    "dev:lan": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "deploy:prod": "bash scripts/deploy_prod.sh",
    "test:ops": "bash scripts/test_gaterank_log_maintenance.sh",
    "server:dev": "tsx watch backend/src/server.ts",
    "server:start": "tsx backend/src/server.ts",
    "server:typecheck": "tsc -p backend/tsconfig.json --noEmit",
    "dns-probe:start": "tsx backend/src/dnsProbeServer.ts",
    "dns-probe:healthcheck": "tsx backend/src/dnsProbeHealthcheck.ts",
    "test:backend": "tsx --test backend/tests/**/*.test.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/geoip-country": "^5.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "dns2": "^3.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "geoip-country": "^5.0.202604172354",
    "helmet": "^8.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "marked": "^17.0.5",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "mysql2": "^3.15.3",
    "nodemailer": "^7.0.13",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "^2.17.4",
    "sharp": "^0.34.5",
    "slugify": "^1.6.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^7.0.11",
    "@types/sanitize-html": "^2.16.1",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.2"
  },
  "description": "GateRank 是一个「机场测评与榜单」系统。   目标是基于稳定性、性能、价格、风险四个维度，生成可解释、可追踪的每日评分与榜单。",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
